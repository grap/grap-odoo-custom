<odoo>

    <template id="report_sale_order" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@name='informations_date']" position="after">

            <div t-if="doc.commitment_date" class="col-auto col-3 mw-100 mb-2" name="commitment_date">
                <strong>Delivery Date:</strong>
                <p class="m-0" t-field="doc.commitment_date" t-options='{"widget": "date"}'/>
            </div>
        </xpath>

    </template>

</odoo>
