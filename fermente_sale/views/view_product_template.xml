<odoo>

    <record id="view_product_template_form_sale" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="priority" eval="100" />
        <field name="inherit_id" ref="sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_policy']" position="attributes">
                <attribute name="string">Invoicing</attribute>
            </xpath>
            <xpath expr="//label[@for='product_tooltip']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[hasclass('text-muted')]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
