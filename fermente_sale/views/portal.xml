<odoo>

    <template id="portal_sale_order" inherit_id="sale.sale_order_portal_content">
        <xpath expr="//span[@t-field='sale_order.date_order']" position="after">
            <div class="mb-3 col-6" t-if="sale_order.commitment_date">
                <strong>Delivery Date:</strong> <span t-field="sale_order.commitment_date" t-options='{"widget": "date"}'/>
            </div>
        </xpath>
    </template>

</odoo>
