<odoo>

    <record id="view_product_template_form_remove_field" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product_maker.view_product_template_maker_form" />
        <field name="arch" type="xml">
            <!-- Remove -->
            <xpath expr="//field[@name='maker_description']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_form_add_field" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product_food.view_product_template_form" />
        <field name="arch" type="xml">
            <!-- Add -->
            <field name="storage_method" position="before">
                <field name="maker_description"/>
            </field>
        </field>
    </record>


</odoo>
