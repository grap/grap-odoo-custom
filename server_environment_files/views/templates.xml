<odoo>

    <template id="web_layout" inherit_id="web.layout" >
        <xpath expr="." position="inside">
            <t t-set="web_layout_path" t-value="request.env['ir.config_parameter'].sudo().get_param('web_layout_path', None)" />
            <link t-if="web_layout_path" rel="stylesheet" t-att-href="web_layout_path"/>
        </xpath>
    </template>

</odoo>
