<odoo>

    <record id="view_report_custom_message_search" model="ir.ui.view">
        <field name="model">report.custom.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="company_id" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="view_report_custom_message_tree" model="ir.ui.view">
        <field name="model">report.custom.message</field>
        <field name="arch" type="xml">
            <tree>
                <field name="background_color" widget="color"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_report_custom_message_form" model="ir.ui.view">
        <field name="model">report.custom.message</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <div class="oe_edit_only">
                            <label for="name" string="Name"/>
                        </div>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="background_color" widget="color"/>
                            <label for="height"/>
                            <div name="height">
                                <field name="height" class="oe_inline"/> px
                            </div>
                            <label for="border"/>
                            <div name="border">
                                <field name="border" class="oe_inline"/> px
                            </div>
                        </group>
                    </group>
                    <group>
                        <group string="Display on" col="4">
                            <field name="display_on_purchase_order" string="Purchase Order" colspan="2"/>
                            <field name="display_on_sale_order" string="Sale Order" colspan="2"/>
                            <field name="display_on_stock_picking" string="Stock Picking" colspan="2"/>
                            <field name="display_on_account_move" string="Account Move" colspan="2"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Message">
                            <group string="HTML Text">
                                <field name="html_text" widget="html" nolabel="1" colspan="2"/>
                            </group>
                            <group string="Preview">
                                <field name="message" widget="html" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Advanced Edition">
                            <group>
                                <field name="extra_css_code"/>
                            </group>
                            <group string="HTML Code">
                                <field name="html_text_code" widget="ace" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_report_custom_message" model="ir.actions.act_window">
        <field name="name">Custom Messages</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">report.custom.message</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_report_custom_message"
        name="Custom Messages"
        parent="base.reporting_menuitem"
        action="action_report_custom_message"/>

</odoo>
