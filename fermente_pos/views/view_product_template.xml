<odoo>

    <record id="view_product_template_tree" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_tree_view" />
        <field name="arch" type="xml">
            <field name="pos_categ_id" position="before">
                <field name="available_in_pos" optional="hide"/>
            </field>
        </field>
    </record>

   <record id="view_product_template_form" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view" />
        <field name="arch" type="xml">
            <field name="to_weight" position="attributes">
                <attribute name="string">To weigh</attribute>
            </field>
        </field>
    </record>

</odoo>
