<odoo noupdate="1">

    <record model="product.product" id="demo_houmous">
        <field name="name">Houmous</field>
        <field name="uom_id" ref="uom.product_uom_kgm" />
        <field name="uom_po_id" ref="uom.product_uom_kgm" />
        <field name="standard_price">20</field>
        <field name="list_price">30</field>
