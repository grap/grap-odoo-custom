<odoo>

    <!-- ************************************************************ -->
    <!-- Product template - Form -->
    <!-- ************************************************************ -->

    <record id="view_product_template_maker_form" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_tag_ids']" position="after">
              <field name="maker_description"/>
            </xpath>
        </field>
    </record>

    <!-- ************************************************************ -->
    <!-- Product product - Form -->
    <!-- ************************************************************ -->

    <record id="view_product_product_maker_form" model="ir.ui.view">
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='additional_product_tag_ids']" position="after">
              <field name="maker_description"/>
            </xpath>
        </field>
    </record>

</odoo>
