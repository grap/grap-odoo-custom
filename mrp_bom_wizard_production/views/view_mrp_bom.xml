<odoo>

    <!-- MRP BOM TREE -->
    <record id="view_wizard_production_mrp_bom_tree" model="ir.ui.view">
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='active']" position="before">
                <header>
                    <button name="action_mrp_bom_wizard_production" type="object" string="Production wizard"/>
                </header>
            </xpath>
        </field>
    </record>


</odoo>
