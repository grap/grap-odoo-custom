<odoo>

    <record id="view_hr_employee_global_search" model="ir.ui.view">
        <field name="model">hr.employee.global</field>
        <field name="arch" type="xml">
            <search>
               <field name="lastname"/>
               <field name="firstname"/>
               <field name="company_id"/>
               <field name="work_email"/>
            </search>
        </field>
    </record>

    <record id="view_hr_employee_global_tree" model="ir.ui.view">
        <field name="model">hr.employee.global</field>
        <field name="arch" type="xml">
            <tree>
                <field name="lastname"/>
                <field name="firstname"/>
                <field name="company_id" />
                <field name="work_email" widget="email"/>
                <field name="mobile_phone" widget="phone"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_employee_global_form" model="ir.ui.view">
        <field name="model">hr.employee.global</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <div name="button_box" class="oe_button_box" />
                    <field name="image_128" invisible="1"/>
                    <div class="o_employee_avatar">
                        <field name="image_1920" widget="image" class="oe_avatar m-0" options="{&quot;zoom&quot;: true, &quot;preview_image&quot;:&quot;image_128&quot;}"/>
                    </div>
                    <div class="oe_title">
                        <h1 class="d-flex flex-row">
                            <field name="name" style="font-size: min(4vw, 2.6rem);"/>
                        </h1>
                    </div>
                    <group string="Public Information">
                        <group>
                            <field name="company_id"/>
                            <field name="work_email" widget="email"/>
                       </group>
                        <group>
                            <field name="mobile_phone" widget="phone"/>
                            <field name="work_phone" widget="phone"/>
                        </group>
                    </group>
                    <group string="Private Information" groups="hr.group_hr_manager">
                       <group>
                            <field name="address_home_email" widget="email"/>
                            <field name="address_home_mobile" widget="phone"/>
                            <field name="address_home_phone" widget="phone"/>
                            <field name="birthday"/>
                       </group>
                        <group>
                            <span class="o_form_label o_td_label">
                                <b>Address</b>
                            </span>
                            <div class="o_address_format">
                                <field name="address_home_street"/>
                                <field name="address_home_street2"/>
                                <field name="address_home_zip" style="width: 50%"/>
                                <field name="address_home_city" style="width: 50%"/>
                                <field name="address_home_country_id"/>
                            </div>
                       </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_employee_global_kanban" model="ir.ui.view">
        <field name="model">hr.employee.global</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="firstname"/>
                <field name="lastname"/>
                <field name="company_id"/>
                <field name="work_email"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_hr_kanban_record">
                           <t t-set="employee_image" t-value="kanban_image('hr.employee.global', 'image_1024', record.id.raw_value)"/>
                            <div class="o_kanban_image_fill_left d-none d-md-block" t-attf-style="background-image:url('#{employee_image}')">
                                <img class="o_kanban_image_inner_pic" t-att-alt="record.company_id.value" t-att-src="kanban_image('res.company', 'logo_web', record.company_id.raw_value)"/>
                            </div>
                            <div class="o_kanban_image d-md-none" t-attf-style="background-image: url(#{employee_image})">
                                <img class="o_kanban_image_inner_pic" t-att-alt="record.company_id.value" t-att-src="kanban_image('res.company', 'logo_web', record.company_id.raw_value)"/>
                            </div>
                            <div class="oe_kanban_details  d-flex flex-column justify-content-between">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <ul>
                                              <li><field name="firstname"/> <field name="lastname"/></li>
                                            </ul>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_tags_section oe_kanban_partner_categories"/>
                                <ul>
                                    <li t-if="record.work_email.raw_value">
                                        <field name="work_email" widget="email"/>
                                    </li>
                                    <li t-if="record.mobile_phone.raw_value">
                                        <field name="mobile_phone" widget="phone"/>
                                    </li>
                                    <li t-if="record.work_phone.raw_value">
                                        <field name="work_phone" widget="phone"/>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_hr_employee_global" model="ir.actions.act_window">
        <field name="name">Directory</field>
        <field name="res_model">hr.employee.global</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <menuitem id="menu_hr_employee_global"
        name="Directory"
        parent="menu_root"
        action="action_hr_employee_global"
        sequence="2"/>

</odoo>
