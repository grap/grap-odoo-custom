<odoo>

    <record id="view_mrp_food_menu_wizard_production_form" model="ir.ui.view">
        <field name="model">mrp.food.menu</field>
        <field name="inherit_id" ref="mrp_food_menu.view_food_menu_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                  <button type="action" string="Production assistant"
                          name="%(mrp_bom_wizard_production.action_mrp_bom_wizard_production)d"
                          icon="fa-print" context="{'food_menu':True}"
                          class="oe_highlight"/>
                </header>
            </xpath>
        </field>
    </record>

</odoo>
